{
  "name": "rendezvous-example-clarinet-project",
  "version": "1.0.0",
  "description": "Example project that allows testing a Clarity contract with @stacks/rendezvous and Clarinet.",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "vitest run",
    "test:report": "vitest run -- --coverage --costs",
    "test:watch": "chokidar \"tests/**/*.ts\" \"contracts/**/*.clar\" -c \"pnpm run test:report\""
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@stacks/clarinet-sdk": "^4.0.0",
    "@stacks/rendezvous": "^1.1.0",
    "@stacks/transactions": "^7.6.0",
    "@types/node": "^26.6.6",
    "chokidar-cli": "^3.0.0",
    "vitest": "^5.0.5",
    "vitest-environment-clarinet": "^4.0.0"
  }
}
