{
  "name": "@stacks/rendezvous",
  "version": "1.1.0",
  "description": "Meet your contract's vulnerabilities head-on.",
  "main": "dist/lib.js",
  "types": "dist/lib.d.ts",
  "bin": {
    "rv": "dist/app.js"
  },
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "default": "./dist/lib.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json && node -e \"if (process.platform !== 'win32') require('fs').chmodSync('./dist/app.js', 0o755);\"",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "lint": "oxlint -c oxlintrc.json",
    "lint:fix": "oxlint -c oxlintrc.json --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "bench": "npm run build && node bench/run.mjs"
  },
  "keywords": [
    "stacks",
    "clarity",
    "fuzz",
    "testing"
  ],
  "author": "Radu Bahmata, Nikos Baxevanis",
  "license": "GPL-3.0-only",
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61",
  "files": [
    "dist/",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stx-labs/rendezvous.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@stacks/clarinet-sdk": "^4.0.0",
    "@stacks/clarinet-sdk-wasm": "^3.26.0",
    "@stacks/transactions": "^7.6.0",
    "fast-check": "^4.10.2"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.0.5",
    "oxlint": "^1.90.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
